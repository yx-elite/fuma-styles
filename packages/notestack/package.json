{
  "name": "@yx-elite/notestack",
  "version": "0.2.1",
  "description": "A Fumadocs theme for study notes",
  "keywords": [
    "fumadocs",
    "fumadocs-theme",
    "nextjs",
    "mdx",
    "docs",
    "notes",
    "study-notes",
    "static-site"
  ],
  "homepage": "https://notestack.yxelite.dev",
  "bugs": {
    "url": "https://github.com/yx-elite/notestack/issues"
  },
  "license": "MIT",
  "author": "Yi Xian Lan <exian0716@gmail.com> (https://github.com/yx-elite)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yx-elite/notestack.git",
    "directory": "packages/notestack"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "WRITING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    },
    "./source": {
      "types": "./dist/source/index.d.ts",
      "default": "./dist/source/index.js"
    },
    "./routes": {
      "types": "./dist/routes/index.d.ts",
      "default": "./dist/routes/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fumadocs/language": "^0.2.21",
    "lucide-react": "^1.71.0"
  },
  "peerDependencies": {
    "@types/mdx": "*",
    "@types/react": "*",
    "fumadocs-core": "^16.19.7",
    "fumadocs-ui": "^16.19.7",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@types/mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
