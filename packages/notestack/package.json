{
  "name": "@yx-elite/notestack",
  "version": "0.0.0",
  "description": "A Fumadocs theme for study notes",
  "license": "MIT",
  "author": "yx-elite <exian0716@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yx-elite/notestack.git",
    "directory": "packages/notestack"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx.d.ts",
      "default": "./dist/mdx.js"
    },
    "./source": {
      "types": "./dist/source/index.d.ts",
      "default": "./dist/source/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "lucide-react": "^1.71.0"
  },
  "peerDependencies": {
    "fumadocs-core": "^16.19.7",
    "fumadocs-ui": "^16.19.7",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
